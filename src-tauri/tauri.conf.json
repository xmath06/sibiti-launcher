{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CBT Launcher",
  "version": "0.1.0",
  "identifier": "com.cbt.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "CBT Launcher",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../proxy-server.mjs",
      { "source": "../backend", "target": "app/backend" },
      { "source": "../frontend", "target": "app/frontend" }
    ],
    "icon": ["icons/icon.ico"]
  }
}
